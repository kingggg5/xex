# Preserve current text bytes; normalize executable shell scripts for Linux.
* -text
*.sh text eol=lf
# Runtime binary art/codecs are required inputs, stored in LFS.
*.glb filter=lfs diff=lfs merge=lfs -text
*.gltf filter=lfs diff=lfs merge=lfs -text
*.ktx2 filter=lfs diff=lfs merge=lfs -text
