# Placeholders only. Copy to an ignored local .env if needed.
# Basic local/cloud smoke can run session-only with no database or OAuth.
AETHERFIELD_DATABASE_URL=
AETHERFIELD_PORT=3001
AETHERFIELD_PUBLIC_ORIGIN=
AETHERFIELD_WS_PROXY_TARGET=ws://127.0.0.1:3001
XEXORIA_MAGE_TRIAL=0
AETHERFIELD_TEST_COMMERCE=0
AETHERFIELD_TEST_ORIGIN=
AETHERFIELD_GOOGLE_CLIENT_ID=
AETHERFIELD_GOOGLE_CLIENT_SECRET=
AETHERFIELD_DISCORD_CLIENT_ID=
AETHERFIELD_DISCORD_CLIENT_SECRET=
# Disposable database test only; never point this to a real player database.
AETHERFIELD_TEST_DATABASE_URL=
# Optional task tool providers belong in cloud Secrets, never browser bundles.
TYPESAFE_API_KEY=
OPENAI_API_KEY=
